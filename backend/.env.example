NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/leaddesk

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# JWT secrets - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Admin seed (used only by `npm run seed`, never at runtime auth)
ADMIN_SEED_EMAIL=admin@leaddesk.dev
ADMIN_SEED_PASSWORD=replace-with-a-strong-password
ADMIN_SEED_NAME=Admin

BCRYPT_COST=12
